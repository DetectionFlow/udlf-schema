{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://detectionflow.com/schemas/udlf/lookup/v0.1.0.json",
  "title": "UDLF Lookup Schema v0.1.0",
  "description": "UDLF lookup schema. A named reference dataset a detection matches against, referenced from a variant's 'requires'. Language-neutral.",
  "type": "object",
  "required": ["id", "name", "title", "metadata", "key", "columns", "data"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for this lookup (UUID v4)."
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,63}$",
      "description": "The token this lookup is referenced by, e.g. 'attacker_tools'."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "Human-readable title."
    },
    "description": {
      "type": "string",
      "description": "What the dataset contains, where it came from, and how it is expected to be maintained."
    },
    "metadata": {
      "type": "object",
      "description": "Provenance and versioning metadata.",
      "required": ["created_at", "version"],
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "type": "string",
          "format": "date",
          "description": "ISO 8601 date the lookup was created (YYYY-MM-DD)."
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "description": "Semantic version number (e.g. 1.0.0, 2.1.3)."
        },
        "authors": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Authors of the lookup."
        }
      }
    },
    "key": {
      "type": "string",
      "minLength": 1,
      "description": "The column matched against. Must name one of the entries in 'columns'."
    },
    "match": {
      "type": "object",
      "description": "How values in the key column are compared. Optional; defaults to exact, case-insensitive.",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["exact", "wildcard", "regex", "cidr"],
          "default": "exact",
          "description": "Comparison semantics. Portability varies: 'exact' everywhere, 'cidr' not on Sentinel, 'wildcard' Splunk and CrowdStrike, 'regex' Google SecOps and CrowdStrike."
        },
        "case_sensitive": {
          "type": "boolean",
          "default": false,
          "description": "Whether comparison is case-sensitive."
        }
      }
    },
    "columns": {
      "type": "array",
      "minItems": 1,
      "description": "The dataset's columns, in order. Includes context-only columns such as a per-row note.",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Column name. Must match the CSV header exactly, or the key of an inline row object."
          },
          "description": {
            "type": "string",
            "description": "What this column holds."
          }
        }
      }
    },
    "data": {
      "description": "Where the rows come from: either an external file or a short list inlined here. Exactly one of the two.",
      "oneOf": [
        {
          "title": "External file",
          "type": "object",
          "required": ["format", "file"],
          "additionalProperties": false,
          "properties": {
            "format": {
              "type": "string",
              "enum": ["csv"],
              "description": "Format of the referenced file."
            },
            "file": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*\\.csv$",
              "description": "Path to the data file, relative to this document. First line must be a header row matching 'columns'."
            }
          }
        },
        {
          "title": "Inline rows",
          "type": "object",
          "required": ["rows"],
          "additionalProperties": false,
          "properties": {
            "rows": {
              "type": "array",
              "minItems": 1,
              "description": "Inline rows, for a short list. Each object's keys must match 'columns'. Prefer 'file' as the list grows.",
              "items": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": ["string", "number", "boolean", "null"]
                }
              }
            }
          }
        }
      ]
    },
    "references": {
      "type": "array",
      "items": { "type": "string", "format": "uri" },
      "description": "External reading URLs. The dataset's upstream source belongs here."
    },
    "changelog": {
      "type": "array",
      "description": "Append-only history of notable changes. The most recent entry's date is the effective last-updated date.",
      "items": {
        "type": "object",
        "required": ["date", "version", "author", "summary"],
        "additionalProperties": false,
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "description": "ISO 8601 date of the change (YYYY-MM-DD)."
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
            "description": "Semantic version this change shipped in (e.g. 1.0.0)."
          },
          "author": {
            "type": "string",
            "minLength": 1,
            "description": "Who made the change."
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "description": "What changed and why."
          }
        }
      }
    }
  }
}
