{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://detectionflow.com/schemas/udlf/macro/v0.1.0.json",
  "title": "UDLF Macro Schema v0.1.0",
  "description": "UDLF macro schema. A named, reusable snippet of query logic referenced from a detection's 'requires'. One language per document.",
  "type": "object",
  "required": ["id", "name", "title", "metadata", "language", "definition"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for this macro document (UUID v4)."
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,63}$",
      "description": "The token this macro is referenced by, e.g. 'security_content_summariesonly'. Shared across language variants."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "Human-readable title. Maps to Sentinel's savedSearches 'displayName' at deploy time."
    },
    "description": {
      "type": "string",
      "description": "What the macro does and when to use it."
    },
    "metadata": {
      "type": "object",
      "description": "Provenance and versioning metadata.",
      "required": ["created_at", "version"],
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "type": "string",
          "format": "date",
          "description": "ISO 8601 date the macro was created (YYYY-MM-DD)."
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "description": "Semantic version number (e.g. 1.0.0, 2.1.3)."
        },
        "authors": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Authors of the macro."
        }
      }
    },
    "language": {
      "type": "string",
      "enum": ["spl", "kql", "cql"],
      "description": "Query language of this macro. Closed to spl, kql and cql, the only platforms with a macro feature."
    },
    "arguments": {
      "type": "array",
      "description": "Ordered parameter list for a parameterised macro. Omit for a zero-argument macro; for spl the count is part of the name.",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
            "description": "Parameter name, as it appears at the substitution point in 'definition'."
          },
          "type": {
            "type": "string",
            "enum": [
              "string",
              "long",
              "int",
              "real",
              "bool",
              "datetime",
              "timespan",
              "dynamic",
              "guid"
            ],
            "description": "Scalar type of the parameter. Required for 'kql', forbidden elsewhere."
          },
          "default": {
            "type": ["string", "number", "boolean"],
            "description": "Default value when the caller omits this argument. Scalar only. Forbidden for 'spl'."
          }
        }
      }
    },
    "definition": {
      "type": "string",
      "minLength": 1,
      "description": "The macro body: the raw query text it expands to. Logic only, no platform mechanics."
    },
    "references": {
      "type": "array",
      "items": { "type": "string", "format": "uri" },
      "description": "External reading URLs."
    },
    "changelog": {
      "type": "array",
      "description": "Append-only history of notable changes. The most recent entry's date is the effective last-updated date.",
      "items": {
        "type": "object",
        "required": ["date", "version", "author", "summary"],
        "additionalProperties": false,
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "description": "ISO 8601 date of the change (YYYY-MM-DD)."
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
            "description": "Semantic version this change shipped in (e.g. 1.0.0)."
          },
          "author": {
            "type": "string",
            "minLength": 1,
            "description": "Who made the change."
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "description": "What changed and why."
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["language"],
        "properties": { "language": { "const": "kql" } }
      },
      "then": {
        "properties": {
          "arguments": {
            "items": { "required": ["name", "type"] }
          }
        }
      }
    },
    {
      "if": {
        "required": ["language"],
        "properties": { "language": { "const": "spl" } }
      },
      "then": {
        "properties": {
          "arguments": {
            "items": {
              "not": {
                "anyOf": [
                  { "required": ["type"] },
                  { "required": ["default"] }
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["language"],
        "properties": { "language": { "const": "cql" } }
      },
      "then": {
        "properties": {
          "arguments": {
            "items": { "not": { "required": ["type"] } }
          }
        }
      }
    }
  ]
}
